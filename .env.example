# Export these values before starting the API; no dotenv loader is required.
MAX_UPLOAD_BYTES=26214400
DO_NOT_TRACK=true
# For offline operation, pre-cache upstream model/NLP assets, then set:
# HF_HUB_OFFLINE=1

# Writable caches avoid stale or read-only caches in package installations.
NUMBA_CACHE_DIR=/tmp/unstructured-io-numba
MPLCONFIGDIR=/tmp/unstructured-io-matplotlib
# Set HF_HOME to $PWD/.venv/model-cache when starting from the project directory.

# Use the same HF_HOME for warm_models.py --sections and the API.
# Resume section inference reads only pre-cached model files.

# DeepSeek review: only this key is required. Setting it enables review of ALL
# assigned/unassigned resume text, including personal/contact details.
DEEPSEEK_API_KEY=
# Optional overrides; sensible defaults are built in.
# DEEPSEEK_REVIEW_ENABLED=false
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_THINKING_MODE=disabled
# DEEPSEEK_TIMEOUT_SECONDS=90
# DEEPSEEK_REVIEW_MAX_UNITS=600
# DEEPSEEK_REVIEW_MAX_INPUT_CHARS=200000
# DEEPSEEK_MAX_TOKENS=16000
