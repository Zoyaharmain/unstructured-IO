{
  "$defs": {
    "Attribute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/AttributeValue"
          },
          "title": "Items",
          "type": "array"
        },
        "status": {
          "default": "unresolved",
          "enum": [
            "mapped",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "AttributeValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceQuote"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "default": "source_supported",
          "enum": [
            "source_supported",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "AttributeValue",
      "type": "object"
    },
    "SourceQuote": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "SourceQuote",
      "type": "object"
    },
    "SubschemaRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "attributes": {
          "items": {
            "$ref": "#/$defs/Attribute"
          },
          "title": "Attributes",
          "type": "array"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "attributes"
      ],
      "title": "SubschemaRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "title": "Category",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/SubschemaRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "residual_blocks": {
      "items": {
        "$ref": "#/$defs/SourceQuote"
      },
      "title": "Residual Blocks",
      "type": "array"
    }
  },
  "required": [
    "category",
    "label",
    "records"
  ],
  "title": "SectionSchema",
  "type": "object"
}
