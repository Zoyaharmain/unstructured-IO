    "/projects/1/name": [
      {
        "source_id": "e15:0:63",
        "quote": "Feature Suggestions Platform — Internal Product Feedback System"
      }
    ],
    "/projects/1/description": [
      {
        "source_id": "e16:0:114",
        "quote": "Designed and delivered a cross-team feature suggestion system serving multiple product teams, enabling structured "
      },
      {
        "source_id": "e16:114:140",
        "quote": "product feedback at scale."
      },
      {
        "source_id": "e17:0:113",
        "quote": "Modeled hierarchical discussions using self-referential Prisma relations, supporting arbitrarily nested comments "
      },
      {
        "source_id": "e17:113:151",
        "quote": "and replies with O(1) lookup per node."
      },
      {
        "source_id": "e18:0:107",
        "quote": "Implemented soft-delete strategies to preserve thread integrity and auditability across comment lifecycles."
      },
      {
        "source_id": "e18:110:225",
        "quote": "Built engagement features (likes, emoji reactions, voting) and email notification workflows for comments, replies, "
      },
      {
        "source_id": "e18:225:256",
        "quote": "and feature status transitions."
      },
      {
        "source_id": "e19:0:119",
        "quote": "Designed a feature lifecycle integrated with Jira, enabling cross-team triage, scheduling, and release tracking from a "
      },
      {
        "source_id": "e19:119:136",
        "quote": "single interface."
      }
    ],
    "/projects/1/technologies/0": [
      {
        "source_id": "e17:0:113",
        "quote": "Prisma"
      }
    ],
    "/projects/1/technologies/1": [
      {
        "source_id": "e19:0:119",
        "quote": "Jira"
      }
    ],
    "/projects/2/name": [
      {
        "source_id": "e20:0:67",
        "quote": "DevPal (DevEx Agent) — Enterprise LLM Developer Platform, 18+ Teams"
      }
    ],
    "/projects/2/description": [
      {
        "source_id": "e21:0:99",
        "quote": "Architected a multi-tenant AI documentation assistant in FastAPI + Azure OpenAI serving 18+ Maersk "
      },
      {
        "source_id": "e21:99:204",
        "quote": "engineering teams, indexing 1,640+ documents and 1,107 GitHub discussions with 3072-dimension embeddings."
      },
      {
        "source_id": "e21:207:310",
        "quote": "Designed a hybrid RAG pipeline: 3-pass LLM shuffle-and-tag ingestion strategy → Reciprocal Rank Fusion "
      },
      {
        "source_id": "e21:310:419",
        "quote": "(RRF) merging tag-based search, vector similarity, and PostgreSQL full-text search — with LLM re-ranking via "
      },
      {
        "source_id": "e21:419:469",
        "quote": "GPT-4.1-mini before answer generation via GPT-4.1."
      },
      {
        "source_id": "e22:0:104",
        "quote": "Eliminated OpenAI Agents SDK overhead by replacing the gpt-4.1 routing agent with a direct gpt-4.1-mini "
      },
      {
        "source_id": "e22:104:212",
        "quote": "structured output call — reducing P50 response time from 33–40s to 22–27s (∼35% faster) and streaming first "
      },
      {
        "source_id": "e22:212:253",
        "quote": "token from 37s to 2–5s (10× improvement)."
      },
      {
        "source_id": "e23:0:104",
        "quote": "Reduced GitHub Discussions initial embedding sync from 55 minutes to ∼5 minutes by replacing sequential "
      },
      {
        "source_id": "e23:104:177",
        "quote": "per-item API calls with batched embedding generation (100 texts/request)."
      },
      {
        "source_id": "e24:0:95",
        "quote": "Designed AI Ticket Triage service (TriageService): LLM completeness check → hybrid retrieval → "
      },
      {
        "source_id": "e24:95:205",
        "quote": "confidence-gated auto-reply (threshold: 0.70) → Hedwig on-call escalation; integrated with MS Teams via Power "
      },
      {
        "source_id": "e24:205:298",
        "quote": "Automate and GitHub Discussions webhooks; built bot-loop prevention via triage state machine."
      },
      {
        "source_id": "e25:2:98",
        "quote": "Built a platform tool registry auto-generated from OpenAPI specs (MDP, MTTS, MRMP, MAC, Stargate"
      },
      {
        "source_id": "e26:0:112",
        "quote": "APIs) enabling the LLM to fetch live platform data — activity logs, service state, Kafka topics, team rosters — "
      },
      {
        "source_id": "e26:112:205",
        "quote": "without leaving the chat interface; user bearer token forwarded, no service principal needed."
      },
      {
        "source_id": "e27:0:96",
        "quote": "Exposed an MCP server with Azure AD OAuth, enabling DevPal to be consumed as a tool in VS Code, "
      },
      {
        "source_id": "e27:96:174",
        "quote": "Microsoft Teams, and Jira — adopted by 100+ engineers across the organization."
      },
      {
        "source_id": "e28:0:99",
        "quote": "Built a 35-panel Grafana + Prometheus production observability stack; diagnosed and fixed 2 silent "
      },
      {
        "source_id": "e28:99:209",
        "quote": "instrumentation bugs (fallback counter never incrementing, latency histogram using wrong label) that had been "
      },
