{
  "$defs": {
    "CategorizedSkills": {
      "properties": {
        "technical_skills": {
          "description": "Programming languages, algorithms, data structures, and core engineering skills",
          "items": {
            "type": "string"
          },
          "title": "Technical Skills",
          "type": "array"
        },
        "tools_and_platforms": {
          "description": "Developer tools, cloud platforms, IDEs, databases, and enterprise software",
          "items": {
            "type": "string"
          },
          "title": "Tools And Platforms",
          "type": "array"
        },
        "domain_and_functional": {
          "description": "Domain expertise, methodologies (e.g. Agile, Banking, FinOps, Risk, Accounting)",
          "items": {
            "type": "string"
          },
          "title": "Domain And Functional",
          "type": "array"
        },
        "soft_skills": {
          "description": "Communication, leadership, project management, and collaborative skills",
          "items": {
            "type": "string"
          },
          "title": "Soft Skills",
          "type": "array"
        },
        "all_skills": {
          "description": "Flat deduplicated list of all extracted skills",
          "items": {
            "type": "string"
          },
          "title": "All Skills",
          "type": "array"
        }
      },
      "title": "CategorizedSkills",
      "type": "object"
    },
    "Certification": {
      "properties": {
        "name": {
          "description": "Certification, license, or course title",
          "title": "Name",
          "type": "string"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Issuing organization (e.g. AWS, Scrum Alliance, Oracle)",
          "title": "Issuer"
        },
        "issue_year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year or date of certification",
          "title": "Issue Year"
        }
      },
      "required": [
        "name"
      ],
      "title": "Certification",
      "type": "object"
    },
    "ContactInfo": {
      "properties": {
        "full_name": {
          "description": "Candidate's full legal or professional name",
          "title": "Full Name",
          "type": "string"
        },
        "email": {
          "description": "Primary contact email address",
          "title": "Email",
          "type": "string"
        },
        "phone": {
          "description": "Contact phone number including country code if available",
          "title": "Phone",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City, state, or country of residence",
          "title": "Location"
        },
        "linkedin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LinkedIn profile URL",
          "title": "Linkedin Url"
        },
        "github_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GitHub or code repository URL",
          "title": "Github Url"
        },
        "portfolio_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Personal website or portfolio URL",
          "title": "Portfolio Url"
        }
      },
      "required": [
        "full_name",
        "email",
        "phone"
      ],
      "title": "ContactInfo",
      "type": "object"
    },
    "Education": {
      "properties": {
        "institution": {
          "description": "University, college, school, or issuing academy name",
          "title": "Institution",
          "type": "string"
        },
        "degree": {
          "description": "Degree or diploma (e.g. 'B.Tech', 'MBA', 'B.Sc', 'Master of Science')",
          "title": "Degree",
          "type": "string"
        },
        "field_of_study": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Major, department, or specialization",
          "title": "Field Of Study"
        },
        "start_year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start year",
          "title": "Start Year"
        },
        "graduation_year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Graduation or completion year",
          "title": "Graduation Year"
        },
        "grade_or_gpa": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GPA, grade, honors, or percentage",
          "title": "Grade Or Gpa"
        }
      },
      "required": [
        "institution",
        "degree"
      ],
      "title": "Education",
      "type": "object"
    },
    "Project": {
      "properties": {
        "name": {
          "description": "Project title or system name",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary of project goals and achievements",
          "title": "Description"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Candidate's role in the project",
          "title": "Role"
        },
        "technologies": {
          "description": "Technologies and libraries used",
          "items": {
            "type": "string"
          },
          "title": "Technologies",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Live URL or repository link",
          "title": "Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "WorkExperience": {
      "properties": {
        "company": {
          "description": "Company, employer, or client organization name",
          "title": "Company",
          "type": "string"
        },
        "role": {
          "description": "Designation, position, or job title",
          "title": "Role",
          "type": "string"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Employment start date (e.g. 'Jan 2021', '2020')",
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Employment end date (e.g. 'Present', 'Dec 2024')",
          "title": "End Date"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total duration or date range string",
          "title": "Duration"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Job location (city/country or Remote)",
          "title": "Location"
        },
        "responsibilities": {
          "description": "Key responsibilities, achievements, and impact bullet points",
          "items": {
            "type": "string"
          },
          "title": "Responsibilities",
          "type": "array"
        },
        "technologies": {
          "description": "Technologies, tools, or frameworks utilized in this role",
          "items": {
            "type": "string"
          },
          "title": "Technologies",
          "type": "array"
        }
      },
      "required": [
        "company",
        "role"
      ],
      "title": "WorkExperience",
      "type": "object"
    }
  },
  "properties": {
    "contact": {
      "$ref": "#/$defs/ContactInfo",
      "description": "Candidate contact details and social profiles"
    },
    "professional_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Candidate's professional headline, primary title, or specialization",
      "title": "Professional Title"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Professional summary, executive bio, or objective statement",
      "title": "Summary"
    },
    "total_experience_years": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Estimated total professional work experience in years",
      "title": "Total Experience Years"
    },
    "skills": {
      "$ref": "#/$defs/CategorizedSkills",
      "description": "Structured and categorized candidate skills"
    },
    "experience": {
      "description": "Complete chronological employment history",
      "items": {
        "$ref": "#/$defs/WorkExperience"
      },
      "title": "Experience",
      "type": "array"
    },
    "education": {
      "description": "Academic education and degree qualifications",
      "items": {
        "$ref": "#/$defs/Education"
      },
      "title": "Education",
      "type": "array"
    },
    "certifications": {
      "description": "Professional certifications, licenses, and accreditations",
      "items": {
        "$ref": "#/$defs/Certification"
      },
      "title": "Certifications",
      "type": "array"
    },
    "projects": {
      "description": "Key projects, client engagements, or open-source work",
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    },
    "languages": {
      "description": "Languages known or spoken",
      "items": {
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    }
  },
  "required": [
    "contact"
  ],
  "title": "ResumeSchema",
  "type": "object"
}
